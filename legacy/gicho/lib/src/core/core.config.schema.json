{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/core.config.schema.json",
  "title": "Moztopia core configuration",
  "description": "Coordinates how package-owned features appear in the standard application shell.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "appBar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brightness": { "$ref": "#/$defs/appBarAction" },
            "theme": { "$ref": "#/$defs/appBarAction" },
            "language": { "$ref": "#/$defs/appBarAction" },
            "configDisplay": { "$ref": "#/$defs/appBarAction" },
            "logout": { "$ref": "#/$defs/appBarAction" }
          }
        }
      }
    }
  },
  "$defs": {
    "appBarAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    }
  }
}
