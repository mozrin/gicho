{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/startup.config.schema.json",
  "title": "Moztopia startup configuration",
  "description": "Controls the launch-icon hold and final startup delay.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startupPreDelayDurationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "startupPostDelayDurationSeconds": {
      "type": "integer",
      "minimum": 0
    }
  }
}
