{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gicho application configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brand", "theme", "app"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "x-moztopia-locked": true
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "logoAsset": {"type": "string", "minLength": 1},
        "markAsset": {"type": "string", "minLength": 1}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "default"],
      "properties": {
        "available": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["default", "ocean", "ember"]}
        },
        "default": {
          "type": "string",
          "enum": ["default", "ocean", "ember"]
        }
      }
    },
    "placeLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["googleApiKey"],
      "properties": {
        "googleApiKey": {"type": "string", "minLength": 1}
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["companyMinimumMilliseconds", "productMinimumMilliseconds", "loadingMinimumMilliseconds", "transition", "transitionMilliseconds"],
          "properties": {
            "companyArtworkAsset": {"type": "string", "minLength": 1},
            "productArtworkAsset": {"type": "string", "minLength": 1},
            "loadingArtworkAsset": {"type": "string", "minLength": 1},
            "companyPortraitSceneAsset": {"type": "string", "minLength": 1},
            "companyLandscapeSceneAsset": {"type": "string", "minLength": 1},
            "productPortraitSceneAsset": {"type": "string", "minLength": 1},
            "productLandscapeSceneAsset": {"type": "string", "minLength": 1},
            "loadingPortraitSceneAsset": {"type": "string", "minLength": 1},
            "loadingLandscapeSceneAsset": {"type": "string", "minLength": 1},
            "countryLookupPath": {"type": "string", "pattern": "^/[^/]"},
            "scheduledProductScenes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "start", "end", "portraitSceneAsset", "landscapeSceneAsset"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "start": {"type": "string", "pattern": "^(\\d{2}-\\d{2}|\\d{4}-\\d{2}-\\d{2})$"},
                  "end": {"type": "string", "pattern": "^(\\d{2}-\\d{2}|\\d{4}-\\d{2}-\\d{2})$"},
                  "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
                  "portraitSceneAsset": {"type": "string", "minLength": 1},
                  "landscapeSceneAsset": {"type": "string", "minLength": 1}
                }
              }
            },
            "companyMinimumMilliseconds": {"type": "integer", "minimum": 0},
            "productMinimumMilliseconds": {"type": "integer", "minimum": 0},
            "loadingMinimumMilliseconds": {"type": "integer", "minimum": 0},
            "transition": {"type": "string", "enum": ["fade", "slide", "scale", "none"]},
            "transitionMilliseconds": {"type": "integer", "minimum": 0}
          },
          "dependentRequired": {
            "companyPortraitSceneAsset": ["companyLandscapeSceneAsset"],
            "companyLandscapeSceneAsset": ["companyPortraitSceneAsset"],
            "productPortraitSceneAsset": ["productLandscapeSceneAsset"],
            "productLandscapeSceneAsset": ["productPortraitSceneAsset"],
            "loadingPortraitSceneAsset": ["loadingLandscapeSceneAsset"],
            "loadingLandscapeSceneAsset": ["loadingPortraitSceneAsset"]
          }
        }
      }
    }
  }
}
