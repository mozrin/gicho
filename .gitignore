# Editor and operating-system files
.idea/
*.iml
.DS_Store

# Dart and Flutter generated artifacts
.dart_tool/
.packages
.pub/
build/
/coverage/
.flutter-plugins-dependencies

# Dependency resolutions belong to each developer's local environment
*.lock
package-lock.json
npm-shrinkwrap.json
pnpm-lock.yaml
bun.lockb

# Native tooling output generated by Flutter
**/.gradle/
**/.cxx/
**/local.properties
**/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/

# Legacy source is tracked as a source snapshot.
**/git-diff.txt
**/dump_files*txt
**/flutter*.png
# Widget Preview related
.widget_preview/

# Separate GitHub wiki checkout and developer configuration
/wiki/
.env
.env.*
!.env.example
*.jks
*.keystore

# Python verification caches
__pycache__/
*.pyc
